{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/pyrosync/**,deploy/pyrosync-demo.duckdb}",
      "excludeFiles": "{sample_data/**,frontend/**,backend/tests/**,data/**,.venv/**}",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}

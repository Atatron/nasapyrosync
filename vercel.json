{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix deploy/blob --no-audit --no-fund",
  "buildCommand": "node deploy/blob/upload.mjs",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/pyrosync/**,deploy/pyrosync-demo.duckdb,deploy/blob/manifest.json}",
      "excludeFiles": "{sample_data/**,frontend/**,backend/tests/**,data/**,.venv/**,deploy/blob/db/**,deploy/blob/node_modules/**,deploy/hf/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}

# PyroSync configuration. Copy to ".env" (same folder) and edit. Every value is optional.
# The .env file stays on your computer and is read only by the local backend.

# Optional NASA FIRMS MAP_KEY for "Refresh from FIRMS API" (Data & Methods → FIRMS API).
# Get one at https://firms.modaps.eosdis.nasa.gov/api/map_key/ . Server-side only: it is never sent
# to the browser, written into exports, or printed in logs/errors. Leave empty to use file imports only.
FIRMS_MAP_KEY=

# Where the database, import reports, raw-file copies and caches live (default: ./data).
PYROSYNC_DATA_DIR=

# Bind address and port. Keep 127.0.0.1 so the app is reachable only from this computer.
PYROSYNC_HOST=127.0.0.1
PYROSYNC_PORT=8000

# Upload / ZIP safety limits (MB, entry count, max compression ratio for entries > 10 MB).
PYROSYNC_MAX_UPLOAD_MB=2048
PYROSYNC_MAX_ZIP_EXPANDED_MB=8192
PYROSYNC_MAX_ZIP_ENTRIES=50000
PYROSYNC_MAX_ZIP_RATIO=200

# Keep a copy of every imported original file under data/raw/<batch> (1 = yes, 0 = no).
PYROSYNC_KEEP_RAW_UPLOADS=1

# 1 = never contact NASA services from the backend (imagery availability uses the bundled snapshot).
# The browser still requests GIBS imagery tiles directly when you choose an imagery layer.
PYROSYNC_OFFLINE=0

# Advanced: service base URLs.
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov
GIBS_BASE_URL=https://gibs.earthdata.nasa.gov
